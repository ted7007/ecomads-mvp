{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ecomads;Username=postgres;Password=postgres"
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://openai.bothub.chat/v1/chat/completions",
