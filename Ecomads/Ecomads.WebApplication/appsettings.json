{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Wb": {
    "AutoRefresh": { "Enabled": true },
    "Recommendations": {
      "Enabled": true,
      "SourcesComparable": true,
      "Rule03Enabled": true,
      "Rule06Enabled": true,
      "PriceScenario": 0.20,
      "NoUnitsSpendFloor": 300,
      "HighDrrMinimumUnits": 3,
      "RetentionDays": 90
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ecomads;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "development_only_secret_key_change_me_32_bytes",
    "Issuer": "ecomads_api",
    "Audience": "ecomads_clients",
    "ExpiryMinutes": 1440
  }
}
