# Local build verification output
# Deployment bundles, test runs, screenshots and one-off verification scripts.
/artifacts/*

# These text files are source specifications referenced by the project docs.
!/artifacts/spec-audit/
/artifacts/spec-audit/*
!/artifacts/spec-audit/*.txt

# Temporary source copies, downloaded references and rendered exports.
/tmp/
/output/
**/TestResults/
**/__pycache__/
*.pyc

# One-off local workbook analysis
/.codex-budget-analysis/

# Local environment files; keep documented templates versioned
.env
.env.*
!.env.example
!.env.*.example
