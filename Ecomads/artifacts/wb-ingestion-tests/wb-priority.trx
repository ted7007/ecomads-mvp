      SELECT c.id AS "Id", (
          SELECT w.target_drr
          FROM wb_campaign_norms AS w
          WHERE w.campaign_id = c.id
          LIMIT 1) AS "CampaignTarget", (
          SELECT w0.min_ctr
          FROM wb_campaign_norms AS w0
          WHERE w0.campaign_id = c.id
          LIMIT 1) AS "CampaignMinCtr", (
          SELECT w1.goal
          FROM wb_campaign_norms AS w1
          WHERE w1.campaign_id = c.id
          LIMIT 1) AS "Goal", c.wb_status AS "WbStatus", c.wb_created_at_utc AS "WbCreatedAtUtc", c.wb_deleted_at_utc AS "WbDeletedAtUtc", (
          SELECT w2.target_drr
          FROM wb_store_norms AS w2
          WHERE w2.store_id = c.store_id
          LIMIT 1) AS "StoreTarget", (
          SELECT w3.min_ctr
          FROM wb_store_norms AS w3
          WHERE w3.store_id = c.store_id
          LIMIT 1) AS "StoreMinCtr"
      FROM campaigns AS c
      WHERE c.id = ANY (@campaignIds)
