      WHERE c.store_id = ANY (@sellerStoreIds) AND (c.is_active OR c.wb_status = 11 OR EXISTS (
          SELECT 1
          FROM campaign_statistics AS c0
          WHERE c0.campaign_id = c.id AND c0.date &gt;= @startDateUtc AND c0.date &lt;= @endDateUtc))
