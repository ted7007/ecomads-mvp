      SELECT w.id, w.attempt_count, w.campaign_ids_json, w.completed_at_utc, w.created_at_utc, w.end_date, w.error_code, w.imported_rows, w.items_with_data, w.items_without_data, w.kind, w.last_request_at_utc, w.next_attempt_at_utc, w.next_campaign_offset, w.pair_ids_json, w.pause_requested_at_utc, w.retried_from_job_id, w.run_id, w.stage, w.start_date, w.started_at_utc, w.status, w.store_id, w.updated_at_utc, w.wait_reason
