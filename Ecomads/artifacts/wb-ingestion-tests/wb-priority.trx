info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (18ms) [Parameters=[@startDateUtc='?' (DbType = DateTime), @endDateUtc='?' (DbType = DateTime), @sellerStoreIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT c.id, COALESCE((
          SELECT w.custom_name
          FROM wb_campaign_norms AS w
          WHERE w.campaign_id = c.id
          LIMIT 1), c.name), c3.c, c3.c0, c3.c1, c3.c2, c3.c3, c3.c4, c3.c5, c3.c6
      FROM campaigns AS c
      LEFT JOIN LATERAL (
          SELECT COALESCE(sum(c2.spend), 0.0) AS c, COALESCE(sum(c2.revenue), 0.0) AS c0, CASE
              WHEN COALESCE(sum(c2.revenue), 0.0) &gt; 0.0 THEN (COALESCE(sum(c2.spend), 0.0) / COALESCE(sum(c2.revenue), 0.0)) * 100.0
              ELSE 0.0
          END AS c1, COALESCE(sum(c2.clicks), 0)::int AS c2, COALESCE(sum(c2.impressions), 0)::int AS c3, CAST(CASE
              WHEN COALESCE(sum(c2.impressions), 0)::int &gt; 0 THEN (COALESCE(sum(c2.clicks), 0)::int * 100) / COALESCE(sum(c2.impressions), 0)::int
              ELSE 0
          END AS numeric) AS c4, count(*)::int AS c5, 1 AS c6
          FROM (
              SELECT c1.clicks, c1.impressions, c1.revenue, c1.spend, 1 AS "Key"
              FROM campaign_statistics AS c1
