      WHERE w.kind IN ('fullstats_month', 'expenses_month', 'funnel_month', 'fullstats', 'funnel_recent', 'expenses', 'fullstats_history', 'expenses_history', 'funnel_year', 'clusters', 'jam', 'archive', 'funnel_backfill') AND w.status IN ('pending', 'running') AND w.pause_requested_at_utc IS NULL AND w.next_attempt_at_utc &lt;= @UtcNow AND EXISTS (
          SELECT 1
          FROM stores AS s
          WHERE s.id = w.store_id AND NOT (s.auto_refresh_blocked) AND (s.token_expires_at_utc IS NULL OR s.token_expires_at_utc &gt; @UtcNow1))
      ORDER BY CASE
          WHEN w.kind IN ('fullstats', 'expenses', 'funnel_recent') THEN 0
          WHEN w.kind IN ('fullstats_month', 'expenses_month', 'funnel_month', 'archive', 'funnel_backfill') THEN 1
          WHEN w.kind IN ('clusters', 'jam') THEN 2
          ELSE 3
      END, w.next_attempt_at_utc
      LIMIT 1
