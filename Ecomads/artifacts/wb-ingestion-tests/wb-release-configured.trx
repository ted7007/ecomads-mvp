          LIMIT 1) AS "Goal", c.wb_status AS "WbStatus", c.wb_created_at_utc AS "WbCreatedAtUtc", c.wb_deleted_at_utc AS "WbDeletedAtUtc", (
          SELECT w2.target_drr
          FROM wb_store_norms AS w2
