      SELECT c.store_id AS "StoreId", c.wb_campaign_id AS "WbCampaignId", c.name AS "Name", s.api_key IS NOT NULL AS "Connected"
      FROM campaigns AS c
      INNER JOIN stores AS s ON c.store_id = s.id
