info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (14ms) [Parameters=[@campaignIds='?' (DbType = Object), @begin='?' (DbType = Date), @window_EndDate='?' (DbType = Date)], CommandType='Text', CommandTimeout='30']
      SELECT w.id, w.average_position, w.campaign_id, w.carts, w.clicks, w.cluster_name, w.cpc, w.cpm, w.ctr, w.date, w.nomenclature_id, w.ordered_products, w.orders, w.spend, w.views, n.id, n.name, n.store_id, n.wb_nomenclature_id
      FROM wb_cluster_statistics AS w
      INNER JOIN nomenclatures AS n ON w.nomenclature_id = n.id
      INNER JOIN campaigns AS c ON w.campaign_id = c.id
      WHERE w.campaign_id = ANY (@campaignIds) AND n.store_id = c.store_id AND w.date &gt;= @begin AND w.date &lt;= @window_EndDate
