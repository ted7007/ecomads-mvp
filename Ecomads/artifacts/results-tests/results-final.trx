      SELECT s.id, s.api_key, s.auto_history_started_at_utc, s.auto_refresh_blocked, s.auto_refresh_enabled, s.campaigns_refreshed_at_utc, s.created_at, s.description, s.external_id, s.jam_checked_at_utc, s.jam_status, s.last_sync_at, s.marketplace, s.name, s.seller_id, s.token_expires_at_utc, s.token_last_four&#xD;
      FROM stores AS s&#xD;
      WHERE s.api_key IS NOT NULL AND NOT (s.auto_refresh_blocked) AND (s.token_expires_at_utc IS NULL OR s.token_expires_at_utc &gt; @now)&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (5ms) [Parameters=[@since='?' (DbType = DateTime), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT w."Id"&#xD;
      FROM wb_response_snapshots AS w&#xD;
      WHERE w."Kind" IN ('fullstats', 'fullstats_month', 'fullstats_history', 'archive', 'clusters') AND w."RequestedAtUtc" &gt;= @since AND w."AppliedAtUtc" IS NOT NULL AND w."State" IN ('applied', 'partial') AND w."Version" &lt;&gt; '3' AND w."HttpStatus" &gt;= 200 AND w."HttpStatus" &lt; 300&#xD;
      ORDER BY w."RequestedAtUtc" DESC, w."Id"&#xD;
      LIMIT @p&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (7ms) [Parameters=[@UtcNow='?' (DbType = DateTime), @UtcNow1='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT w.id, w.attempt_count, w.campaign_ids_json, w.completed_at_utc, w.created_at_utc, w.end_date, w.error_code, w.imported_rows, w.items_with_data, w.items_without_data, w.kind, w."LastProgressAtUtc", w.last_request_at_utc, w.next_attempt_at_utc, w.next_campaign_offset, w.pair_ids_json, w.pause_requested_at_utc, w.retried_from_job_id, w.run_id, w.stage, w.start_date, w.started_at_utc, w.status, w.store_id, w.updated_at_utc, w.wait_reason&#xD;
      FROM wb_sync_jobs AS w&#xD;
      WHERE w.kind IN ('fullstats_month', 'expenses_month', 'funnel_month', 'fullstats', 'funnel_recent', 'expenses', 'fullstats_history', 'expenses_history', 'funnel_year', 'clusters', 'jam', 'archive', 'funnel_backfill', 'product_orders') AND w.status IN ('pending', 'running') AND w.pause_requested_at_utc IS NULL AND w.next_attempt_at_utc &lt;= @UtcNow AND EXISTS (&#xD;
          SELECT 1&#xD;
          FROM stores AS s&#xD;
          WHERE s.id = w.store_id AND NOT (s.auto_refresh_blocked) AND (s.token_expires_at_utc IS NULL OR s.token_expires_at_utc &gt; @UtcNow1))&#xD;
      ORDER BY CASE&#xD;
          WHEN w.kind IN ('fullstats', 'expenses', 'funnel_recent') THEN 0&#xD;
          WHEN w.kind IN ('fullstats_month', 'expenses_month', 'funnel_month', 'archive', 'funnel_backfill', 'product_orders') THEN 1&#xD;
          WHEN w.kind IN ('clusters', 'jam') THEN 2&#xD;
          ELSE 3&#xD;
      END, w.next_attempt_at_utc&#xD;
      LIMIT 1&#xD;
