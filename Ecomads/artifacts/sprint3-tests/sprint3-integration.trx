      DELETE FROM wb_recommendation_runs AS w&#xD;
      WHERE w."CalculatedAtUtc" &lt; @cutoff AND NOT EXISTS (&#xD;
          SELECT 1&#xD;
          FROM wb_snapshot_decisions AS w0&#xD;
          WHERE w0."RunId" = w."Id") AND (w."SchemaVersion" &gt;= 3 OR NOT EXISTS (&#xD;
