      Executed DbCommand (320ms) [Parameters=[@campaignId='?' (DbType = Guid), @sellerId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT c.store_id AS "StoreId", c.wb_campaign_id AS "WbCampaignId", c.name AS "Name", c.wb_status AS "WbStatus", s.api_key IS NOT NULL AS "Connected"&#xD;
      FROM campaigns AS c&#xD;
      INNER JOIN stores AS s ON c.store_id = s.id&#xD;
      WHERE c.id = @campaignId AND s.seller_id = @sellerId&#xD;
      LIMIT 2&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (139ms) [Parameters=[@campaignIds='?' (DbType = Object), @begin='?' (DbType = Date), @window_EndDate='?' (DbType = Date)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT w.id, w.average_position, w.campaign_id, w.carts, w.clicks, w.cluster_name, w.cpc, w.cpm, w.ctr, w.date, w.nomenclature_id, w.ordered_products, w.orders, w.spend, w.views, n.id, n.name, n.store_id, n.wb_nomenclature_id&#xD;
      FROM wb_cluster_statistics AS w&#xD;
      INNER JOIN nomenclatures AS n ON w.nomenclature_id = n.id&#xD;
      INNER JOIN campaigns AS c ON w.campaign_id = c.id&#xD;
      WHERE w.campaign_id = ANY (@campaignIds) AND n.store_id = c.store_id AND w.date &gt;= @begin AND w.date &lt;= @window_EndDate&#xD;
      ORDER BY w.nomenclature_id, w.cluster_name, w.date&#xD;
