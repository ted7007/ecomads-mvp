      SELECT w.id, w.attempt_count, w.campaign_ids_json, w.completed_at_utc, w.created_at_utc, w.end_date, w.error_code, w.imported_rows, w.items_with_data, w.items_without_data, w.kind, w.last_request_at_utc, w.next_attempt_at_utc, w.next_campaign_offset, w.pair_ids_json, w.pause_requested_at_utc, w.retried_from_job_id, w.run_id, w.stage, w.start_date, w.started_at_utc, w.status, w.store_id, w.updated_at_utc, w.wait_reason&#xD;
      FROM wb_sync_jobs AS w&#xD;
      WHERE w.kind IN ('fullstats_month', 'expenses_month', 'funnel_month', 'fullstats', 'funnel_recent', 'expenses', 'fullstats_history', 'expenses_history', 'funnel_year', 'clusters', 'jam', 'archive', 'funnel_backfill') AND w.status IN ('pending', 'running') AND w.pause_requested_at_utc IS NULL AND w.next_attempt_at_utc &lt;= @UtcNow AND EXISTS (&#xD;
          SELECT 1&#xD;
          FROM stores AS s&#xD;
          WHERE s.id = w.store_id AND NOT (s.auto_refresh_blocked) AND (s.token_expires_at_utc IS NULL OR s.token_expires_at_utc &gt; @UtcNow1))&#xD;
      ORDER BY CASE&#xD;
          WHEN w.kind IN ('fullstats', 'expenses', 'funnel_recent') THEN 0&#xD;
          WHEN w.kind IN ('fullstats_month', 'expenses_month', 'funnel_month', 'archive', 'funnel_backfill') THEN 1&#xD;
          WHEN w.kind IN ('clusters', 'jam') THEN 2&#xD;
          ELSE 3&#xD;
      END, w.next_attempt_at_utc&#xD;
      LIMIT 1&#xD;
