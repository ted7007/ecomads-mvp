      SELECT c.id, COALESCE((&#xD;
          SELECT w.custom_name&#xD;
          FROM wb_campaign_norms AS w&#xD;
          WHERE w.campaign_id = c.id&#xD;
          LIMIT 1), c.name), c3.c, c3.c0, c3.c1, c3.c2, c3.c3, c3.c4, c3.c5, c3.c6&#xD;
      FROM campaigns AS c&#xD;
      LEFT JOIN LATERAL (&#xD;
          SELECT COALESCE(sum(c2.spend), 0.0) AS c, COALESCE(sum(c2.revenue), 0.0) AS c0, CASE&#xD;
              WHEN COALESCE(sum(c2.revenue), 0.0) &gt; 0.0 THEN (COALESCE(sum(c2.spend), 0.0) / COALESCE(sum(c2.revenue), 0.0)) * 100.0&#xD;
              ELSE 0.0&#xD;
          END AS c1, COALESCE(sum(c2.clicks), 0)::int AS c2, COALESCE(sum(c2.impressions), 0)::int AS c3, CAST(CASE&#xD;
              WHEN COALESCE(sum(c2.impressions), 0)::int &gt; 0 THEN (COALESCE(sum(c2.clicks), 0)::int * 100) / COALESCE(sum(c2.impressions), 0)::int&#xD;
              ELSE 0&#xD;
          END AS numeric) AS c4, count(*)::int AS c5, 1 AS c6&#xD;
          FROM (&#xD;
              SELECT c1.clicks, c1.impressions, c1.revenue, c1.spend, 1 AS "Key"&#xD;
              FROM campaign_statistics AS c1&#xD;
              WHERE c1.campaign_id = c.id AND c1.date &gt;= @startDateUtc AND c1.date &lt;= @endDateUtc&#xD;
