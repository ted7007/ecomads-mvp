          WHEN w.kind IN ('fullstats_month', 'expenses_month', 'funnel_month', 'archive', 'funnel_backfill', 'product_orders') THEN 1&#xD;
          WHEN w.kind IN ('clusters', 'jam') THEN 2&#xD;
