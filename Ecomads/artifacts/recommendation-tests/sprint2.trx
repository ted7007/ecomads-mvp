      Executed DbCommand (3ms) [Parameters=[@campaignId='?' (DbType = Guid), @sellerId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT c.store_id AS "StoreId", c.wb_campaign_id AS "WbCampaignId", c.name AS "Name", s.api_key IS NOT NULL AS "Connected"&#xD;
      FROM campaigns AS c&#xD;
