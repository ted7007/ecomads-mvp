      SELECT c.id AS "Id", (&#xD;
          SELECT w.target_drr&#xD;
          FROM wb_campaign_norms AS w&#xD;
          WHERE w.campaign_id = c.id&#xD;
          LIMIT 1) AS "CampaignTarget", (&#xD;
          SELECT w0.min_ctr&#xD;
          FROM wb_campaign_norms AS w0&#xD;
          WHERE w0.campaign_id = c.id&#xD;
          LIMIT 1) AS "CampaignMinCtr", (&#xD;
          SELECT w1.goal&#xD;
          FROM wb_campaign_norms AS w1&#xD;
          WHERE w1.campaign_id = c.id&#xD;
          LIMIT 1) AS "Goal", c.wb_status AS "WbStatus", c.wb_created_at_utc AS "WbCreatedAtUtc", c.wb_deleted_at_utc AS "WbDeletedAtUtc", (&#xD;
          SELECT w2.target_drr&#xD;
          FROM wb_store_norms AS w2&#xD;
          WHERE w2.store_id = c.store_id&#xD;
          LIMIT 1) AS "StoreTarget", (&#xD;
          SELECT w3.min_ctr&#xD;
          FROM wb_store_norms AS w3&#xD;
          WHERE w3.store_id = c.store_id&#xD;
          LIMIT 1) AS "StoreMinCtr"&#xD;
      FROM campaigns AS c&#xD;
      WHERE c.id = ANY (@campaignIds)&#xD;
